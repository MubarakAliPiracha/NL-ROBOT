<?xml version="1.0"?>
<!-- nlbot: diff-drive base + 4-DOF arm + parallel gripper. Primitives only (no meshes),
     so the Three.js viewport URDF loader has nothing to fail on.

     Arm geometry is deliberately a 1-DOF turret + 3R planar arm so the IK is closed-form
     (see bridge/kinematics.py). L1/L2/L3 and ARM_BASE below MUST match that file. -->
<robot name="nlbot">

  <material name="body"><color rgba="0.15 0.45 0.95 1"/></material>
  <material name="dark"><color rgba="0.08 0.09 0.12 1"/></material>
  <material name="accent"><color rgba="1.0 0.48 0.18 1"/></material>
  <material name="steel"><color rgba="0.72 0.75 0.80 1"/></material>

  <!-- ================= base ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.40 0.30 0.12"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.40 0.30 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="6.0"/>
      <inertia ixx="0.0522" iyy="0.0872" izz="0.1250" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="wheel_left_link">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.04"/></geometry><material name="dark"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.04"/></geometry></collision>
    <inertial><origin rpy="1.5708 0 0"/><mass value="0.6"/>
      <inertia ixx="0.00104" iyy="0.00104" izz="0.00192" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_left_link"/>
    <origin xyz="0 0.17 0.08"/><axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_right_link">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.04"/></geometry><material name="dark"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.04"/></geometry></collision>
    <inertial><origin rpy="1.5708 0 0"/><mass value="0.6"/>
      <inertia ixx="0.00104" iyy="0.00104" izz="0.00192" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_right_link"/>
    <origin xyz="0 -0.17 0.08"/><axis xyz="0 1 0"/>
  </joint>

  <link name="caster_link">
    <visual><geometry><sphere radius="0.04"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.04"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="6.4e-5" iyy="6.4e-5" izz="6.4e-5" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster_link"/><origin xyz="-0.15 0 0.04"/>
  </joint>

  <!-- Frame only. No sensor tag: rendering sensors produce nothing headless without a
       GPU, so bridge/scan.py raycasts the world list and publishes /scan instead. -->
  <link name="laser_link">
    <visual><geometry><cylinder radius="0.04" length="0.04"/></geometry><material name="accent"/></visual>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/><origin xyz="0.14 0 0.18"/>
  </joint>

  <!-- ================= arm: turret + 3R planar ================= -->
  <!-- ARM_BASE = (0.12, 0, 0.16) in base_link -->
  <link name="arm_base_link">
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry><material name="steel"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="3.5e-4" iyy="3.5e-4" izz="4.0e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="arm_yaw_joint" type="revolute">
    <parent link="base_link"/><child link="arm_base_link"/>
    <origin xyz="0.12 0 0.16"/><axis xyz="0 0 1"/>
    <limit lower="-2.60" upper="2.60" effort="40" velocity="2.0"/>
  </joint>

  <!-- L1 = 0.25 -->
  <link name="arm_link_1">
    <visual><origin xyz="0.125 0 0"/><geometry><box size="0.25 0.05 0.05"/></geometry><material name="accent"/></visual>
    <collision><origin xyz="0.125 0 0"/><geometry><box size="0.25 0.05 0.05"/></geometry></collision>
    <inertial><origin xyz="0.125 0 0"/><mass value="0.8"/>
      <inertia ixx="3.33e-4" iyy="4.33e-3" izz="4.33e-3" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="arm_shoulder_joint" type="revolute">
    <parent link="arm_base_link"/><child link="arm_link_1"/>
    <origin xyz="0 0 0.03"/><axis xyz="0 -1 0"/>
    <limit lower="-1.90" upper="1.90" effort="40" velocity="2.0"/>
  </joint>

  <!-- L2 = 0.22 -->
  <link name="arm_link_2">
    <visual><origin xyz="0.11 0 0"/><geometry><box size="0.22 0.04 0.04"/></geometry><material name="steel"/></visual>
    <collision><origin xyz="0.11 0 0"/><geometry><box size="0.22 0.04 0.04"/></geometry></collision>
    <inertial><origin xyz="0.11 0 0"/><mass value="0.6"/>
      <inertia ixx="1.6e-4" iyy="2.5e-3" izz="2.5e-3" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="arm_elbow_joint" type="revolute">
    <parent link="arm_link_1"/><child link="arm_link_2"/>
    <origin xyz="0.25 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-2.40" upper="2.40" effort="30" velocity="2.0"/>
  </joint>

  <!-- L3 = 0.09 (wrist -> TCP) -->
  <link name="arm_link_3">
    <visual><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.035 0.035"/></geometry><material name="accent"/></visual>
    <collision><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.035 0.035"/></geometry></collision>
    <inertial><origin xyz="0.045 0 0"/><mass value="0.25"/>
      <inertia ixx="5.1e-5" iyy="1.94e-4" izz="1.94e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="arm_wrist_joint" type="revolute">
    <parent link="arm_link_2"/><child link="arm_link_3"/>
    <origin xyz="0.22 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-2.00" upper="2.00" effort="20" velocity="2.0"/>
  </joint>

  <!-- ================= parallel gripper: 0 .. 0.03 m per finger ================= -->
  <link name="gripper_left_link">
    <visual><geometry><box size="0.02 0.01 0.06"/></geometry><material name="dark"/></visual>
    <collision><geometry><box size="0.02 0.01 0.06"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="1.54e-5" iyy="1.67e-5" izz="2.1e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="arm_link_3"/><child link="gripper_left_link"/>
    <origin xyz="0.09 0.012 0"/><axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="20" velocity="0.4"/>
  </joint>

  <link name="gripper_right_link">
    <visual><geometry><box size="0.02 0.01 0.06"/></geometry><material name="dark"/></visual>
    <collision><geometry><box size="0.02 0.01 0.06"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="1.54e-5" iyy="1.67e-5" izz="2.1e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="arm_link_3"/><child link="gripper_right_link"/>
    <origin xyz="0.09 -0.012 0"/><axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.03" effort="20" velocity="0.4"/>
  </joint>

  <!-- ================= Gazebo ================= -->
  <gazebo reference="caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="wheel_left_link"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="wheel_right_link"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>

  <!-- DiffDrive owns the wheels. Deliberate: the whole base demo therefore has ZERO
       dependency on gz_ros2_control, so an arm-toolchain problem cannot sink it. -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/model/nlbot/cmd_vel</topic>
      <odom_topic>/model/nlbot/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>2.0</max_linear_acceleration>
    </plugin>
  </gazebo>

  <!-- Arm + gripper only. Wheel joints must NOT appear here: DiffDrive owns them. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="arm_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.6</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.2</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_wrist_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-0.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.03</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_right_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.03</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/sim/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
