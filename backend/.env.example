# Put your key here to let the robot understand free-form requests.
# Copy this file to .env (same folder) and remove the leading # below.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: NL_ROBOT_MODEL=claude-opus-5   (or claude-haiku-4-5 for faster/cheaper)
# Only needed if your key isn't scoped to one workspace (the error will tell you):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
