<?xml version="1.0"?>
<!-- Sample differential-drive rover: two driven wheels, two passive casters, lidar + camera links. -->
<robot name="sample_rover">
  <material name="body"><color rgba="0.15 0.45 0.95 1"/></material>
  <material name="dark"><color rgba="0.08 0.09 0.12 1"/></material>
  <material name="accent"><color rgba="1.0 0.48 0.18 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.5 0.3 0.1"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.5 0.3 0.1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.08"/>
      <mass value="8"/>
      <inertia ixx="0.09" iyy="0.16" izz="0.2" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.002" iyy="0.003" izz="0.002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.175 0.08"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.002" iyy="0.003" izz="0.002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.175 0.08"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_caster">
    <visual><geometry><sphere radius="0.04"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.04"/></geometry></collision>
    <contact><lateral_friction value="0.0"/></contact>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.2 0 0.04"/>
  </joint>

  <link name="rear_caster">
    <visual><geometry><sphere radius="0.04"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.04"/></geometry></collision>
    <contact><lateral_friction value="0.0"/></contact>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.2 0 0.04"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="accent"/>
    </visual>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.12 0 0.175"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0 0.11"/>
  </joint>
</robot>
